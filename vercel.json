{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/real-estate", "destination": "/index.html" },
    { "source": "/real-estate/:id", "destination": "/index.html" },
    { "source": "/property-management", "destination": "/index.html" },
    { "source": "/company-formation", "destination": "/index.html" },
    { "source": "/digital-marketing", "destination": "/index.html" },
    { "source": "/car-rentals", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" }
  ]
}
